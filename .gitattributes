# Normalise line endings to LF in the repository and on checkout
* text=auto eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.vsdx   binary
*.zip    binary
*.tgz    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Text files that are sometimes mistaken for binary
*.svg    text
*.drawio text

# Language statistics: examples and docs are not source code
examples/**        linguist-documentation
docs/**            linguist-documentation
package-lock.json  linguist-generated
