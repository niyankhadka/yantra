{
  "name": "@niyankhadka/yantra",
  "version": "1.2.0",
  "type": "module",
  "description": "Make your AI show its work: interactive, step-by-step diagrams, answer pages and books from a short JSON description, written by you or your coding agent. Automatic layout and a validator; CLI, MCP server, playground and Python SDK.",
  "keywords": [
    "diagram",
    "architecture-diagram",
    "sequence-diagram",
    "flowchart",
    "er-diagram",
    "state-machine",
    "mind-map",
    "interactive",
    "walkthrough",
    "documentation",
    "mermaid",
    "plantuml",
    "drawio",
    "visio",
    "svg",
    "html",
    "offline",
    "mcp",
    "mcp-server",
    "cli"
  ],
  "license": "MIT",
  "author": "niyankhadka",
  "homepage": "https://yantra.nbk.com.np/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyankhadka/yantra.git"
  },
  "bugs": {
    "url": "https://github.com/niyankhadka/yantra/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/niyankhadka"
  },
  "bin": {
    "yantra": "./bin/yantra.js"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp/",
    "src/",
    "schemas/",
    "skills/",
    "docs/*.md",
    "examples/",
    "dist/",
    "index.html",
    "vite.config.js",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:site": "vite --config site/vite.config.js",
    "build:site": "vite build --config site/vite.config.js",
    "preview:site": "vite preview --config site/vite.config.js",
    "dev:playground": "vite --config site/vite.config.js --open /playground/",
    "build:playground": "npm run build:site",
    "preview:playground": "npm run preview:site",
    "validate": "node bin/yantra.js validate",
    "test": "node --test",
    "mcp": "node mcp/server.js",
    "prepack": "npm run build",
    "pack:skill": "node scripts/pack-chat.js skill",
    "pack:gpt": "node scripts/pack-chat.js gpt"
  },
  "devDependencies": {
    "marked": "18.1.0",
    "vite": "^8.3.5"
  }
}
