          "payload": {
            "method": "POST",
            "endpoint": "/pharmacy/v2/discharge/reconcile",
            "status": "200 Cleared For Discharge",
            "latency": "10ms",
            "protocol": "FHIR MedicationRequest",
            "body": {
              "patient_status": "AMBULATORY_RECOVERED",
              "discharge_prescriptions": [
                "Cefazolin 1g",
                "Enoxaparin 40mg SC"
              ],
              "contraindication_check": "ZERO_INTERACTIONS_CONFIRMED",
              "follow_up_clinic": "Outpatient Trauma Review (7 Days)"
            }
          }
        }
      ]
    }
