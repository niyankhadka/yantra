    {
      "id": "acute-trauma",
      "name": "Acute Trauma Triage & Emergency Surgery",
      "badge": "Flow 1",
      "description": "Time-critical clinical trajectory: ESI Level 1 ambulance intake, rapid dual-energy CT diagnostic scan, emergency trauma surgery, and ICU telemetry.",
      "steps": [
        {
          "id": "step-1",
          "title": "Hospital Clinical Care Pathway",
          "description": "Interconnected acute clinical network linking intake triage, EHR clinical records, diagnostic imaging, robotic surgery, ICU, and clinical pharmacy.",
          "highlightNodes": [
            "node-triage",
            "node-ehr",
            "node-radiology",
            "node-surgical",
            "node-icu",
            "node-discharge"
          ],
          "highlightEdges": [
            "edge-triage-ehr",
            "edge-triage-radio",
            "edge-radio-surgical",
            "edge-ehr-surgical",
            "edge-surgical-icu",
            "edge-icu-discharge",
            "edge-discharge-ehr"
          ],
          "payload": {
            "method": "INFO",
            "endpoint": "/clinical/v1/emergency/status",
            "status": "TRAUMA_CENTER_LEVEL_1_READY",
            "latency": "1ms",
            "protocol": "FHIR / HL7",
            "body": {
              "open_trauma_bays": 4,
              "ct_scanner_availability": "IMMEDIATE",
              "blood_bank_units_o_neg": 64,
              "on_call_surgeons": [
                "Dr. K. Vance (Trauma)",
                "Dr. M. Chen (Vascular)"
              ]
            }
          }
        },
        {
          "id": "step-2",
          "title": "Emergency Intake & Automated Vitals Acuity Triage",
          "description": "Vitals monitor detects acute hypotension (BP 82/50, HR 128). Triage protocol triggers automated trauma code and rapid CT imaging order.",
          "highlightNodes": [
            "node-triage",
            "node-ehr",
            "node-radiology"
          ],
          "highlightEdges": [
            "edge-triage-ehr",
            "edge-triage-radio"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/fhir/Observation/vitals-acuity",
            "status": "201 Created",
            "latency": "4ms",
            "protocol": "HL7 FHIR R4",
            "body": {
              "encounter_id": "ENC-EMERG-2026-9912",
              "esi_acuity_level": 1,
              "blood_pressure": "82/50 mmHg",
              "heart_rate_bpm": 128,
              "priority": "STAT_CODE_TRAUMA"
            }
          }
        },
        {
          "id": "step-3",
          "title": "Dual-Energy Diagnostic CT & AI Hemorrhage Flag",
          "description": "Patient completes rapid torso CT scan. AI computer-vision classifier detects internal bleed in under 45 seconds and automatically routes 3D volume to OR-1.",
          "highlightNodes": [
            "node-radiology",
            "node-surgical"
          ],
          "highlightEdges": [
            "edge-radio-surgical"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/dicom/v2/imaging/pacs/alert",
            "status": "200 Alert Dispatched",
            "latency": "7ms",
            "protocol": "DICOM Web (WADO-RS)",
            "body": {
              "study_instance_uid": "1.2.840.113619.2.55.2026.918",
              "finding": "ACTIVE_RETROPERITONEAL_HEMORRHAGE",
              "ai_confidence": "98.4%",
              "suggested_action": "EMERGENCY_LAPAROTOMY"
            }
          }
        },
        {
          "id": "step-4",
          "title": "Surgical OR Hemostasis & Cross-Match Transfusion",
          "description": "Trauma surgeon accesses EHR cross-matched blood supplies and executes targeted hemostasis using the robotic surgical platform.",
          "highlightNodes": [
            "node-ehr",
            "node-surgical",
            "node-icu"
          ],
          "highlightEdges": [
            "edge-ehr-surgical",
            "edge-surgical-icu"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/clinical/v1/surgical/report",
            "status": "200 Hemostasis Achieved",
            "latency": "12ms",
            "protocol": "FHIR / REST",
            "body": {
              "procedure": "EMERGENCY_LAPAROSCOPIC_HEMOSTASIS",
              "estimated_blood_loss_ml": 450,
              "transfusion_units": 2,
              "vital_stability": "STABILIZING",
              "transfer_target": "ICU_BED_04"
            }
          }
        },
        {
          "id": "step-5",
          "title": "Post-Operative Recovery & Pharmacological Discharge",
          "description": "After 48h of ICU telemetry, patient stabilizes. Clinical pharmacy runs electronic drug-interaction checks and prepares recovery medication.",
          "highlightNodes": [
            "node-icu",
            "node-discharge",
            "node-ehr"
          ],
          "highlightEdges": [
            "edge-icu-discharge",
