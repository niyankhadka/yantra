        {
          "type": "gantt",
          "title": "Follow-up plan",
          "start": "2025-11-28",
          "items": [
            {
              "id": "detect",
              "title": "Latency alert fires",
              "start": "2025-11-28",
              "days": 1,
              "group": "Respond",
              "tone": "bad"
            },
            {
              "id": "mitigate",
              "title": "Pause index rebuild",
              "after": "detect",
              "days": 1,
              "group": "Respond"
            },
            {
              "id": "fix",
              "title": "Add search replicas",
              "after": "mitigate",
              "days": 3,
              "group": "Fix"
            },
            {
              "title": "Review published",
              "milestone": true,
              "after": "fix",
              "tone": "good"
            }
