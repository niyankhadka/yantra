  "scenarios": [
    {
      "id": "tour",
      "name": "Black Friday morning",
      "steps": [
        {
          "id": "s1",
          "title": "The whole dashboard",
          "description": "Four shop services report to one metrics pipeline; three chart cards show what the on-call team watches, and alert rules page a person."
        },
        {
          "id": "s2",
          "title": "Services report metrics",
          "description": "Every service sends its readings every 15 seconds; each card shows its own: traffic, error budget, authorisation rate and search latency.",
          "highlightNodes": [
            "storefront",
            "checkout",
            "payments",
            "search",
            "metrics"
          ],
          "highlightEdges": [
            "e-store",
            "e-check",
            "e-pay",
            "e-search"
          ]
        },
        {
          "id": "s3",
          "title": "Latency crosses the line",
          "description": "At 11:00 checkout, payments and search p95 latency rise above the 250 ms target; last Friday stayed under it.",
          "highlightNodes": [
            "metrics",
            "latency-chart"
          ],
          "highlightEdges": [
            "e-latency"
          ]
        },
        {
          "id": "s4",
          "title": "Orders hold up",
          "description": "Orders dip from 4,200 to 3,100 an hour but recover by 12:00; the error mix shows acquirer declines as the largest cause.",
          "highlightNodes": [
            "metrics",
            "orders-chart",
            "errors-chart"
          ],
          "highlightEdges": [
            "e-orders",
            "e-errors"
          ]
        },
        {
          "id": "s5",
          "title": "An alert pages on-call",
          "description": "Two thresholds fire; the alert rules page the on-call engineer, who pauses the index rebuild.",
          "highlightNodes": [
            "latency-chart",
            "errors-chart",
            "alerts",
            "oncall"
          ],
          "highlightEdges": [
            "e-l-alert",
            "e-e-alert",
