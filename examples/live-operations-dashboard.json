{
  "meta": {
    "title": "Live operations dashboard",
    "description": "How Northgate Outfitters watches its online shop: services report metrics, dashboards chart them, and alert rules page the on-call engineer.",
    "layout": {
      "direction": "LR"
    },
    "summary": {
      "headline": "One metrics pipeline feeds every chart; two charts carry alert thresholds.",
      "points": [
        "Each service card shows its own live reading.",
        "Chart cards show the dashboards the on-call team watches.",
        "Alert rules turn a breached threshold into a page within two minutes."
      ],
      "facts": {
        "Snapshot": "Black Friday, 28/11/2025",
        "Owner": "Site reliability team"
      }
    }
  },
