    {
      "id": "alarm",
      "name": "A night-time alarm",
      "steps": [
        {
          "title": "The trust in one frame",
          "description": "Trust, hospital, department, ward, bay and bed. The emergency department and the community hospital start folded."
        },
        {
          "title": "The monitor in Bed 4 alarms",
          "description": "Heart rhythm changes at 02:10; the monitor and the infusion pump report to the bay display.",
          "highlightNodes": [
            "h-monitor",
            "h-pump",
            "h-bay-screen"
          ],
          "highlightEdges": [
            "h-e1",
            "h-e2"
          ],
          "focusGroup": "h-bed4"
        },
        {
          "title": "The ward hears it",
          "description": "The bay display raises the alarm at the nurses' station on Ward 7.",
          "highlightNodes": [
            "h-bay-screen",
            "h-station"
          ],
          "highlightEdges": [
            "h-e3"
          ],
          "focusGroup": "h-ward7"
        },
        {
          "title": "The hub escalates",
          "description": "The monitoring hub sees the same telemetry, pages the on-call cardiologist and files the observations.",
          "highlightNodes": [
            "h-monitor",
            "h-hub",
            "h-oncall",
            "h-epr"
          ],
          "highlightEdges": [
            "h-e4",
            "h-e5",
            "h-e6"
          ]
        },
        {
          "title": "Where the patient came from",
          "description": "Focusing the emergency department unfolds it: triage, resuscitation, then the transfer to Ward 7.",
          "highlightNodes": [
            "h-triage",
            "h-resus",
            "h-station"
          ],
          "highlightEdges": [
            "h-e7",
            "h-e8"
