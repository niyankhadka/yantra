{
  "meta": {
    "title": "Autonomous Order & Payment Pipeline",
    "description": "High-throughput, event-driven transaction processing architecture with zero-trust validation.",
    "summary": {
      "headline": "Checkout is an event-driven saga: every step is authorised, recorded and can be compensated.",
      "points": [
        "Zero-trust ingress: every request is authenticated before it reaches a service",
        "Temporal orchestrates the order saga, so failures roll back instead of half-completing",
        "Kafka decouples the ledger from the payment path",
        "CockroachDB is the multi-region source of truth"
      ],
      "facts": {
        "Peak load": "45k req/s",
        "p99 latency": "8 ms at the edge",
        "Availability target": "99.999%"
      }
    },
    "version": "1.4.0",
    "defaultMode": "prod",
    "layout": {
      "direction": "LR"
    }
  },
  "roles": {
    "edge": {
      "label": "Edge & security",
      "color": "blue"
    },
    "service": {
      "label": "Service",
      "color": "teal"
    },
    "data": {
      "label": "Data",
      "color": "violet"
    },
    "external": {
      "label": "External",
      "color": "slate"
    }
  },
