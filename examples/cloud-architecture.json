  "scenarios": [
    {
      "id": "happy-path",
      "name": "Order Fulfillment Saga",
      "badge": "Flow 1",
      "description": "Standard checkout trajectory through zero-trust auth, internal saga coordination, payment authorization, and ledger commit.",
      "steps": [
        {
          "id": "step-1",
          "title": "System Architecture Overview",
          "description": "Distributed checkout architecture operating across zero-trust API ingress, Temporal saga coordination, Kafka event mesh, and CockroachDB distributed ledger.",
          "highlightNodes": [
            "node-client",
            "node-auth",
            "node-order",
            "node-queue",
            "node-payment",
            "node-db"
          ],
          "highlightEdges": [
            "edge-client-auth",
            "edge-client-order",
            "edge-order-payment",
            "edge-order-queue",
            "edge-order-db",
            "edge-queue-db"
          ],
          "payload": {
            "method": "INFO",
            "endpoint": "/v1/healthz",
            "status": "200 OK",
            "latency": "2ms",
            "protocol": "HTTP/2",
            "body": {
              "status": "HEALTHY",
              "region": "us-east-1",
              "active_nodes": 6,
              "throughput_rps": 45280
            }
          }
        },
        {
          "id": "step-2",
          "title": "Edge Ingress & Zero-Trust Authentication",
          "description": "Client request reaches API Gateway. The gateway queries the Auth Broker to validate the cryptographic Ed25519 signature and tenant scopes.",
          "highlightNodes": [
            "node-client",
            "node-auth"
          ],
          "highlightEdges": [
            "edge-client-auth"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/auth/v1/introspect",
            "status": "200 Active",
            "latency": "6ms",
            "protocol": "gRPC (mTLS)",
            "body": {
              "token_id": "tok_99bf21a7",
              "subject": "usr_c8419f20e8b2",
              "roles": [
                "customer:checkout",
                "tenant:us_east"
              ],
              "algorithm": "Ed25519",
              "expires_in": 3540
            }
          }
        },
        {
          "id": "step-3",
          "title": "Order Ingestion & Saga Coordination",
          "description": "With authorization confirmed, the request enters the Order Orchestrator which starts an idempotent saga workflow to coordinate downstream settlement.",
          "highlightNodes": [
            "node-client",
            "node-order"
          ],
          "highlightEdges": [
            "edge-client-order"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/v1/orders",
            "status": "202 Accepted",
            "latency": "14ms",
            "protocol": "HTTP/2 (mTLS)",
            "body": {
              "order_id": "ord_88194412",
              "customer_id": "usr_c8419f20e8b2",
              "items": [
                {
                  "sku": "SKU-PRO-4K",
                  "qty": 1,
                  "price": 1499
                }
              ],
              "saga_id": "saga_984bfa10"
            }
          }
        },
        {
          "id": "step-4",
          "title": "Synchronous Payment Capture",
          "description": "The saga calls the payment service with an idempotency key to capture card payment and secure authorization holds.",
          "highlightNodes": [
            "node-order",
            "node-payment"
          ],
          "highlightEdges": [
            "edge-order-payment"
          ],
          "payload": {
            "method": "POST",
            "endpoint": "/v1/charges/capture",
            "status": "200 Authorized",
            "latency": "112ms",
            "protocol": "HTTPS",
            "body": {
              "charge_id": "ch_3PzQ8jLkdIw9",
              "amount_cents": 149900,
              "currency": "USD",
              "status": "succeeded"
            }
          }
        },
        {
          "id": "step-5",
          "title": "Event Mesh Publication",
          "description": "With funds secured, the saga asynchronously publishes an immutable OrderCreated event into the partitioned Kafka cluster.",
          "highlightNodes": [
            "node-order",
            "node-queue"
          ],
          "highlightEdges": [
            "edge-order-queue"
          ],
          "payload": {
            "method": "EVENT",
            "endpoint": "kafka://orders.v1.created#partition-4",
            "status": "Committed offset 849201",
            "latency": "3ms",
            "protocol": "Kafka Binary (TCP)",
            "body": {
              "event_type": "ORDER_CREATED",
              "order_id": "ord_88194412",
              "timestamp": "2026-10-19T18:00:00Z"
            }
          }
        },
        {
          "id": "step-6",
          "title": "Distributed Ledger State Commit",
          "description": "The transaction completes with serializable isolation, writing the order state and audit log to CockroachDB.",
          "highlightNodes": [
            "node-order",
            "node-db",
            "node-queue"
          ],
          "highlightEdges": [
            "edge-order-db",
            "edge-queue-db"
          ],
          "payload": {
            "method": "SQL",
            "endpoint": "crdb://orders-cluster:26257/production",
            "status": "1 row inserted (linearizable)",
            "latency": "18ms",
            "protocol": "PostgreSQL v14 Wire",
            "body": {
              "query": "INSERT INTO orders (id, status, total) VALUES ($1, $2, $3) RETURNING *;",
              "rows_affected": 1
            }
          }
        }
      ]
    }
  ],
