        "tech": "Envoy v1.30, Cloudflare Workers",
        "runtime": "Edge V8 Isolates",
        "ports": "443 (HTTPS), 8443 (mTLS)",
        "sourceFile": "deploy/envoy/envoy.yaml:14",
        "uptime": "99.999%",
        "description": "Perimeter ingress controller enforcing rate-limiting, geo-routing, DDoS mitigation, and cryptographically verified mTLS handshakes."
      }
    },
    {
      "id": "node-auth",
      "type": "edge",
      "data": {
        "title": "Auth0 / JWT Token Broker",
