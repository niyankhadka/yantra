    {
      "id": "glossary",
      "title": "Glossary",
      "blocks": [
        {
          "type": "table",
          "columns": [
            "Term",
            "Meaning"
          ],
          "rows": [
            [
              "Saga",
              "A sequence of local steps, each with a compensating step"
            ],
            [
              "Compensation",
              "The action that undoes a completed step"
            ],
            [
              "mTLS",
              "Mutual TLS: both sides present certificates"
