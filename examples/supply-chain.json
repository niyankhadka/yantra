          }
        },
        {
          "id": "step-4",
          "title": "ASRS Robotic Ingestion & Slot Allocation",
          "description": "Cleared pallets enter the robotic fulfillment mega-hub. Autonomous mobile robots (AGVs) sort, barcode-index, and store materials in high-bay racking.",
