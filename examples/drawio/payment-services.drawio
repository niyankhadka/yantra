<mxfile host="app.diagrams.net">
  <diagram id="pay" name="Payment services">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="app" value="Mobile app" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mobile_client;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="gw" value="API gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="pay" value="Payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="refund" value="Refunds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="fraud" value="Fraud check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="120" height="60" as="geometry"/></mxCell>
        <mxCell id="fn" value="Receipt sender" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="200" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="db" value="Ledger" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="mail" value="Email service" style="image;html=1;image=img/lib/clip_art/networking/Email_128x128.png;" vertex="1" parent="1"><mxGeometry x="800" y="40" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTPS" style="endArrow=classic;html=1;" edge="1" parent="1" source="app" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="charge" style="endArrow=classic;html=1;" edge="1" parent="1" source="gw" target="pay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="refund" style="endArrow=classic;html=1;" edge="1" parent="1" source="gw" target="refund"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="score" style="endArrow=classic;html=1;" edge="1" parent="1" source="pay" target="fraud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="paid event" style="endArrow=classic;dashed=1;html=1;" edge="1" parent="1" source="pay" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="post entry" style="endArrow=classic;html=1;" edge="1" parent="1" source="pay" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="post reversal" style="endArrow=classic;html=1;" edge="1" parent="1" source="refund" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="send receipt" style="endArrow=classic;html=1;" edge="1" parent="1" source="fn" target="mail"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
